{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>quokkify/renovate-presets//presets/base",
    "github>quokkify/renovate-presets//presets/gradle/default",
    "github>quokkify/renovate-presets//presets/github-actions/default"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "packageRules": [
    {
      "description": "Keep the Maven API floor at 3.9.0: mavenApi also sets the plugin's requiredMavenVersion, so raising it raises the minimum Maven for consumers. Change it deliberately, by hand (ADR 0005, AGENTS.md rule 6).",
      "matchPackageNames": [
        "org.apache.maven:maven-core",
        "org.apache.maven:maven-plugin-api"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python runtime versions in workflows.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["python-version:\\s*\\\"(?<currentValue>3\\.\\d+)\\\""],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "Update the pip version installed by the Python CI workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "pip-version:\\s*\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "pip",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
